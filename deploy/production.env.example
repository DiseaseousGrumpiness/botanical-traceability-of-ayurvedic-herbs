# Copy to production.env on the deployment host, then restrict it to its operator.
# It is intentionally ignored by Git once named production.env.
APP_DOMAIN=trace.example.invalid
ACME_EMAIL=operator@example.invalid

# This must be the existing private Fabric Docker network, not a new network.
FABRIC_NETWORK_NAME=fabric_test
FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=herb-traceability
FABRIC_MSP_HOST_PATH=/srv/botanical/credentials/user-msp
FABRIC_TLS_CERT_HOST_PATH=/srv/botanical/credentials/peer-tls-ca.crt
BOTANICAL_UID=10001
BOTANICAL_GID=10001

# Configure private, high-entropy role tokens on the server. {} disables writes.
AUTH_TOKENS_JSON='{}'
