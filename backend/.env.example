PORT=3001
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=herb-traceability

# Point these to the existing local enrollment and TLS files. Do not copy
# certificates or private keys into the repository.
FABRIC_USER_MSP_DIR=C:/path/to/existing/user/msp
FABRIC_PEER_TLS_CERT=C:/path/to/existing/peer/tls/ca.crt

# Server-side bearer-token RBAC. Map each secret token to one role and actor ID.
# Leave empty to fail closed (all writes return 401 until configured).
# Generate private tokens; never use the example placeholder as a credential.
# Shape: {"<random-token-at-least-24-characters>":{"role":"COLLECTOR","actorId":"COLLECTOR-001"}}
AUTH_TOKENS_JSON={}
WEB_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
BACKEND_HOST=127.0.0.1

# Optional Kubo IPFS HTTP API. Document writes remain disabled until chaincode
# v1.2 (sequence 3) is installed and committed by authorized network operators.
IPFS_API_URL=
IPFS_API_TOKEN=
IPFS_GATEWAY_URL=
DOCUMENT_CID_ENABLED=false
DOCUMENT_CID_CHAINCODE_SEQUENCE=2
